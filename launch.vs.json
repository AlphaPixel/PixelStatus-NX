      "args": [
        "${workspaceRoot}/examples/pixelstatus.sample.json",
        "--api-token",
        "pixelstatus-vs-debug",
        "--api-port",
        "18787",
        "--web-display-port",
        "18788",
        "--web-refresh-ms",
        "100"
      ]
    },
