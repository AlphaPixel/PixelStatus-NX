# Normalize repository text to LF so Windows autocrlf settings cannot create churn.
* text=auto

.gitattributes text eol=lf
.gitignore text eol=lf
.gitmodules text eol=lf

CMakeLists.txt text eol=lf
*.cmake text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf

*.c text eol=lf
*.cc text eol=lf
*.cpp text eol=lf
*.h text eol=lf
*.hh text eol=lf
*.hpp text eol=lf
*.inl text eol=lf

*.ps1 text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

# Common binary artifacts must never undergo line-ending conversion.
*.bmp binary
*.gif binary
*.ico binary
*.jpg binary
*.jpeg binary
*.png binary
*.webp binary
*.pdf binary
*.bin binary
*.elf binary
*.zip binary
*.gz binary
*.xz binary
