{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-debug",
      "displayName": "Windows x64 Debug",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-debug",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PIXELSTATUS_BUILD_HOST_HTTP": "ON",
        "PIXELSTATUS_BUILD_SIMULATOR": "ON",
        "PIXELSTATUS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "windows-core-debug",
      "displayName": "Windows x64 portable core Debug",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/windows-core-debug",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PIXELSTATUS_BUILD_HOST_HTTP": "OFF",
        "PIXELSTATUS_BUILD_SIMULATOR": "OFF",
        "PIXELSTATUS_BUILD_TESTS": "ON"
      }
    },
    {
      "name": "linux-debug",
      "displayName": "Linux headless/browser Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/linux-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PIXELSTATUS_BUILD_HOST_HTTP": "ON",
        "PIXELSTATUS_BUILD_SIMULATOR": "ON",
        "PIXELSTATUS_BUILD_TESTS": "ON",
        "PIXELSTATUS_ENABLE_OPENSSL": "ON"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "linux-release",
      "displayName": "Linux headless/browser Release",
      "inherits": "linux-debug",
      "binaryDir": "${sourceDir}/out/build/linux-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "linux-core-debug",
      "displayName": "Linux portable core Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/linux-core-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "PIXELSTATUS_BUILD_HOST_HTTP": "OFF",
        "PIXELSTATUS_BUILD_SIMULATOR": "OFF",
        "PIXELSTATUS_BUILD_TESTS": "ON",
        "PIXELSTATUS_ENABLE_OPENSSL": "OFF"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug"
    },
    {
      "name": "windows-core-debug",
      "configurePreset": "windows-core-debug",
      "configuration": "Debug"
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug"
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release"
    },
    {
      "name": "linux-core-debug",
      "configurePreset": "linux-core-debug"
    }
  ],
  "testPresets": [
    {
      "name": "windows-debug",
      "configurePreset": "windows-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-core-debug",
      "configurePreset": "windows-core-debug",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-debug",
      "configurePreset": "linux-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-release",
      "configurePreset": "linux-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-core-debug",
      "configurePreset": "linux-core-debug",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
