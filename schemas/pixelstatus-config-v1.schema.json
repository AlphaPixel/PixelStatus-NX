{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelstatus-nx.local/schemas/pixelstatus-config-v1.schema.json",
  "title": "PixelStatus NX configuration version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "display",
    "statuses",
    "indicators"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "display": {
      "$ref": "#/$defs/display"
    },
    "statuses": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "required": [
        "unknown",
        "stale"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/status"
      }
    },
    "indicators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/indicator"
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "positiveDuration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
    },
    "percentage": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]?|100)%$"
        }
      ]
    },
    "appearanceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "duration"
      ],
      "properties": {
        "color": {
          "$ref": "#/$defs/color"
        },
        "duration": {
          "$ref": "#/$defs/positiveDuration"
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "background": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appearance"
      ],
      "properties": {
        "appearance": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "solid"
              ],
              "properties": {
                "solid": {
                  "$ref": "#/$defs/color"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "blink"
              ],
              "properties": {
                "blink": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "color",
                    "on",
                    "off"
                  ],
                  "properties": {
                    "color": {
                      "$ref": "#/$defs/color"
                    },
                    "on": {
                      "$ref": "#/$defs/positiveDuration"
                    },
                    "off": {
                      "$ref": "#/$defs/positiveDuration"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "toggle"
              ],
              "properties": {
                "toggle": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "colors",
                    "period"
                  ],
                  "properties": {
                    "colors": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 16,
                      "items": {
                        "$ref": "#/$defs/color"
                      }
                    },
                    "period": {
                      "$ref": "#/$defs/positiveDuration"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fade"
              ],
              "properties": {
                "fade": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "from",
                    "to",
                    "period"
                  ],
                  "properties": {
                    "from": {
                      "$ref": "#/$defs/color"
                    },
                    "to": {
                      "$ref": "#/$defs/color"
                    },
                    "period": {
                      "$ref": "#/$defs/positiveDuration"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pulse"
              ],
              "properties": {
                "pulse": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "color",
                    "period"
                  ],
                  "properties": {
                    "color": {
                      "$ref": "#/$defs/color"
                    },
                    "period": {
                      "$ref": "#/$defs/positiveDuration"
                    },
                    "minimum": {
                      "$ref": "#/$defs/percentage"
                    },
                    "maximum": {
                      "$ref": "#/$defs/percentage"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sequence"
              ],
              "properties": {
                "sequence": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "steps"
                  ],
                  "properties": {
                    "repeat": {
                      "type": "boolean",
                      "default": true
                    },
                    "steps": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 64,
                      "items": {
                        "$ref": "#/$defs/appearanceStep"
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cycle"
              ],
              "properties": {
                "cycle": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "steps"
                  ],
                  "properties": {
                    "transition": {
                      "type": "string",
                      "enum": [
                        "step",
                        "linear"
                      ],
                      "default": "linear"
                    },
                    "steps": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 64,
                      "items": {
                        "$ref": "#/$defs/appearanceStep"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    }
  }
}
