{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pixelstatus-nx.local/schemas/pixelstatus-config-v1.schema.json",
  "title": "PixelStatus NX configuration version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "display",
    "statuses",
    "indicators"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "display": {
      "$ref": "#/$defs/display"
    },
    "statuses": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "required": [
        "unknown",
        "stale"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/status"
      }
    },
    "monitors": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/monitor"
      }
    },
    "indicators": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/indicator"
      }
    }
  },
  "$defs": {
    "color": {
      "type": "string",
      "pattern": "^#[0-9A-Fa-f]{6}$"
    },
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "positiveDuration": {
      "type": "string",
      "pattern": "^[1-9][0-9]*(ms|s|m|h)$"
    },
    "percentage": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]?|100)%$"
        }
      ]
    },
    "appearanceStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "color",
        "duration"
      ],
      "properties": {
        "color": {
          "$ref": "#/$defs/color"
        },
        "duration": {
          "$ref": "#/$defs/positiveDuration"
        }
      }
    },
    "scalarValue": {
      "type": [
        "null",
        "boolean",
        "number",
        "string"
      ]
    },
    "valueComparison": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["exists"],
          "properties": {"exists": {"const": true}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not_exists"],
          "properties": {"not_exists": {"const": true}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["equals"],
          "properties": {"equals": {"$ref": "#/$defs/scalarValue"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not_equals"],
          "properties": {"not_equals": {"$ref": "#/$defs/scalarValue"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["contains"],
          "properties": {"contains": {"type": "string"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not_contains"],
          "properties": {"not_contains": {"type": "string"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["greater_than"],
          "properties": {"greater_than": {"type": "number"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["greater_or_equal"],
          "properties": {"greater_or_equal": {"type": "number"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["less_than"],
          "properties": {"less_than": {"type": "number"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["less_or_equal"],
          "properties": {"less_or_equal": {"type": "number"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["between"],
          "properties": {
            "between": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {"type": "number"}
            }
          }
        }
      ]
    },
    "evaluationRule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["when", "status"],
          "properties": {
            "when": {
              "type": "object",
              "additionalProperties": false,
              "required": ["value"],
              "properties": {
                "value": {"$ref": "#/$defs/valueComparison"}
              }
            },
            "status": {"$ref": "#/$defs/identifier"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["otherwise"],
          "properties": {
            "otherwise": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status"],
              "properties": {
                "status": {"$ref": "#/$defs/identifier"}
              }
            }
          }
        }
      ]
    },
    "httpObservation": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status_code"],
          "properties": {"status_code": {"const": true}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["body"],
          "properties": {"body": {"const": true}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["json_pointer"],
          "properties": {
            "json_pointer": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^$|^/"
            }
          }
        }
      ]
    },
    "monitor": {
      "oneOf": [
        {"$ref": "#/$defs/httpMonitor"},
        {"$ref": "#/$defs/tcpConnectMonitor"},
        {"$ref": "#/$defs/tcpExchangeMonitor"},
        {"$ref": "#/$defs/dnsMonitor"}
      ]
    },
    "httpMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "url",
        "interval",
        "observe",
        "evaluate"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "type": {"const": "http"},
        "url": {
          "type": "string",
          "maxLength": 2048,
          "pattern": "^https?://"
        },
        "method": {
          "type": "string",
          "enum": ["GET", "HEAD", "POST", "PUT", "PATCH", "DELETE"],
          "default": "GET"
        },
        "headers": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[!#$%&'*+.^_`|~0-9A-Za-z-]+$"
          },
          "additionalProperties": {
            "type": "string",
            "maxLength": 2048,
            "pattern": "^[^\\x00-\\x1F\\x7F]*$"
          }
        },
        "body": {
          "type": "string",
          "maxLength": 16384
        },
        "interval": {"$ref": "#/$defs/positiveDuration"},
        "ttl": {"$ref": "#/$defs/positiveDuration"},
        "timeout": {"$ref": "#/$defs/positiveDuration"},
        "maximum_response_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536,
          "default": 4096
        },
        "observe": {"$ref": "#/$defs/httpObservation"},
        "transport_failure_status": {"$ref": "#/$defs/identifier"},
        "no_match_status": {"$ref": "#/$defs/identifier"},
        "evaluate": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/evaluationRule"}
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["body"],
            "properties": {"body": {"minLength": 1}}
          },
          "then": {
            "required": ["method"],
            "properties": {
              "method": {"enum": ["POST", "PUT", "PATCH", "DELETE"]}
            }
          }
        }
      ]
    },
    "tcpConnectMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "host",
        "port",
        "interval",
        "evaluate"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "type": {"const": "tcp_connect"},
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[^\\s/?#\\[\\]]+$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "interval": {"$ref": "#/$defs/positiveDuration"},
        "ttl": {"$ref": "#/$defs/positiveDuration"},
        "timeout": {"$ref": "#/$defs/positiveDuration"},
        "transport_failure_status": {"$ref": "#/$defs/identifier"},
        "no_match_status": {"$ref": "#/$defs/identifier"},
        "evaluate": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/evaluationRule"}
        }
      }
    },
    "tcpExchangeMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "host",
        "port",
        "interval",
        "read_until",
        "observe",
        "evaluate"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "type": {"const": "tcp_exchange"},
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[^\\s/?#\\[\\]]+$"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "interval": {"$ref": "#/$defs/positiveDuration"},
        "ttl": {"$ref": "#/$defs/positiveDuration"},
        "timeout": {"$ref": "#/$defs/positiveDuration"},
        "send": {
          "type": "string",
          "maxLength": 4096
        },
        "read_until": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "maximum_response_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536,
          "default": 4096
        },
        "observe": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["body"],
              "properties": {"body": {"const": true}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["latency_ms"],
              "properties": {"latency_ms": {"const": true}}
            }
          ]
        },
        "transport_failure_status": {"$ref": "#/$defs/identifier"},
        "no_match_status": {"$ref": "#/$defs/identifier"},
        "evaluate": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/evaluationRule"}
        }
      }
    },
    "dnsMonitor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "host",
        "interval",
        "observe",
        "evaluate"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "type": {"const": "dns"},
        "host": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[^\\s/?#\\[\\]]+$"
        },
        "family": {
          "type": "string",
          "enum": ["any", "ipv4", "ipv6"],
          "default": "any"
        },
        "interval": {"$ref": "#/$defs/positiveDuration"},
        "ttl": {"$ref": "#/$defs/positiveDuration"},
        "timeout": {"$ref": "#/$defs/positiveDuration"},
        "observe": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["addresses"],
              "properties": {"addresses": {"const": true}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["address_count"],
              "properties": {"address_count": {"const": true}}
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["latency_ms"],
              "properties": {"latency_ms": {"const": true}}
            }
          ]
        },
        "transport_failure_status": {"$ref": "#/$defs/identifier"},
        "no_match_status": {"$ref": "#/$defs/identifier"},
        "evaluate": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/evaluationRule"}
        }
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height"
      ],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "background": {
          "$ref": "#/$defs/color"
        }
      }
    },
    "status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "appearance"
      ],
      "properties": {
        "appearance": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "solid"
              ],
              "properties": {
                "solid": {
                  "$ref": "#/$defs/color"
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "blink"
              ],
              "properties": {
                "blink": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "color",
                    "on",
                    "off"
                  ],
                  "properties": {
                    "color": {
                      "$ref": "#/$defs/color"
                    },
                    "on": {
                      "$ref": "#/$defs/positiveDuration"
                    },
                    "off": {
                      "$ref": "#/$defs/positiveDuration"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "toggle"
              ],
              "properties": {
                "toggle": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "colors",
                    "period"
                  ],
                  "properties": {
                    "colors": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 16,
                      "items": {
                        "$ref": "#/$defs/color"
                      }
                    },
                    "period": {
                      "$ref": "#/$defs/positiveDuration"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fade"
              ],
              "properties": {
                "fade": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "from",
                    "to",
                    "period"
                  ],
                  "properties": {
                    "from": {
                      "$ref": "#/$defs/color"
                    },
                    "to": {
                      "$ref": "#/$defs/color"
                    },
                    "period": {
                      "$ref": "#/$defs/positiveDuration"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "pulse"
              ],
              "properties": {
                "pulse": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "color",
                    "period"
                  ],
                  "properties": {
                    "color": {
                      "$ref": "#/$defs/color"
                    },
                    "period": {
                      "$ref": "#/$defs/positiveDuration"
                    },
                    "minimum": {
                      "$ref": "#/$defs/percentage"
                    },
                    "maximum": {
                      "$ref": "#/$defs/percentage"
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "sequence"
              ],
              "properties": {
                "sequence": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "steps"
                  ],
                  "properties": {
                    "repeat": {
                      "type": "boolean",
                      "default": true
                    },
                    "steps": {
                      "type": "array",
                      "minItems": 1,
                      "maxItems": 64,
                      "items": {
                        "$ref": "#/$defs/appearanceStep"
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "cycle"
              ],
              "properties": {
                "cycle": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "steps"
                  ],
                  "properties": {
                    "transition": {
                      "type": "string",
                      "enum": [
                        "step",
                        "linear"
                      ],
                      "default": "linear"
                    },
                    "steps": {
                      "type": "array",
                      "minItems": 2,
                      "maxItems": 64,
                      "items": {
                        "$ref": "#/$defs/appearanceStep"
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source",
        "x",
        "y",
        "width",
        "height"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "source": {
          "$ref": "#/$defs/identifier"
        },
        "x": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "y": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        }
      }
    }
  }
}
