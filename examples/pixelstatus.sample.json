{
  "schema_version": 1,
  "display": {
    "width": 16,
    "height": 16,
    "background": "#080A10"
  },
  "statuses": {
    "ok": {
      "appearance": {
        "solid": "#00C853"
      }
    },
    "info": {
      "appearance": {
        "cycle": {
          "transition": "linear",
          "steps": [
            {
              "color": "#0050C8",
              "duration": "1s"
            },
            {
              "color": "#40C4FF",
              "duration": "1s"
            }
          ]
        }
      }
    },
    "fail": {
      "appearance": {
        "blink": {
          "color": "#FF1744",
          "on": "500ms",
          "off": "500ms"
        }
      }
    },
    "stale": {
      "appearance": {
        "pulse": {
          "color": "#FF9100",
          "period": "2s",
          "minimum": "10%",
          "maximum": "100%"
        }
      }
    },
    "unknown": {
      "appearance": {
        "toggle": {
          "colors": [
            "#D500F9",
            "#6200EA"
          ],
          "period": "500ms"
        }
      }
    },
    "communication_failure": {
      "appearance": {
        "sequence": {
          "repeat": true,
          "steps": [
            {
              "color": "#FF00FF",
              "duration": "200ms"
            },
            {
              "color": "#000000",
              "duration": "200ms"
            },
            {
              "color": "#FF00FF",
              "duration": "200ms"
            },
            {
              "color": "#000000",
              "duration": "1400ms"
            }
          ]
        }
      }
    },
    "fade_demo": {
      "appearance": {
        "fade": {
          "from": "#001020",
          "to": "#00A0FF",
          "period": "2s"
        }
      }
    }
  },
  "indicators": [
    {
      "id": "internet-region",
      "source": "internet",
      "x": 0,
      "y": 0,
      "width": 8,
      "height": 8
    },
    {
      "id": "build-region",
      "source": "build",
      "x": 8,
      "y": 0,
      "width": 8,
      "height": 8
    },
    {
      "id": "backup-region",
      "source": "backup",
      "x": 0,
      "y": 8,
      "width": 8,
      "height": 8
    },
    {
      "id": "freshness-region",
      "source": "freshness-demo",
      "x": 8,
      "y": 8,
      "width": 8,
      "height": 8
    }
  ]
}
