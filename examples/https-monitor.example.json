{
  "schema_version": 1,
  "display": {
    "width": 1,
    "height": 1,
    "background": "#000000"
  },
  "statuses": {
    "ok": {
      "appearance": {
        "solid": "#00C853"
      }
    },
    "communication_failure": {
      "appearance": {
        "solid": "#FF00FF"
      }
    },
    "stale": {
      "appearance": {
        "solid": "#FF9100"
      }
    },
    "unknown": {
      "appearance": {
        "solid": "#6200EA"
      }
    }
  },
  "monitors": [
    {
      "id": "public-https",
      "type": "http",
      "url": "https://example.com/",
      "headers": {
        "Accept": "text/html"
      },
      "interval": "30s",
      "ttl": "90s",
      "timeout": "5s",
      "maximum_response_bytes": 4096,
      "observe": {
        "status_code": true
      },
      "evaluate": [
        {
          "when": {
            "value": {
              "equals": 200
            }
          },
          "status": "ok"
        },
        {
          "otherwise": {
            "status": "unknown"
          }
        }
      ]
    }
  ],
  "indicators": [
    {
      "id": "public-https-indicator",
      "source": "public-https",
      "x": 0,
      "y": 0,
      "width": 1,
      "height": 1
    }
  ]
}
