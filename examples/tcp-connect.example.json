{
  "schema_version": 1,
  "display": {
    "width": 1,
    "height": 1,
    "background": "#000000"
  },
  "statuses": {
    "ok": {
      "appearance": {
        "solid": "#00C853"
      }
    },
    "warn": {
      "appearance": {
        "solid": "#FFD600"
      }
    },
    "communication_failure": {
      "appearance": {
        "solid": "#FF00FF"
      }
    },
    "stale": {
      "appearance": {
        "solid": "#FF9100"
      }
    },
    "unknown": {
      "appearance": {
        "solid": "#6200EA"
      }
    }
  },
  "monitors": [
    {
      "id": "tcp-health",
      "type": "tcp_connect",
      "host": "127.0.0.1",
      "port": 18080,
      "interval": "10s",
      "ttl": "30s",
      "timeout": "1s",
      "evaluate": [
        {
          "when": {
            "value": {
              "greater_or_equal": 500
            }
          },
          "status": "warn"
        },
        {
          "otherwise": {
            "status": "ok"
          }
        }
      ]
    }
  ],
  "indicators": [
    {
      "id": "tcp-health-indicator",
      "source": "tcp-health",
      "x": 0,
      "y": 0,
      "width": 1,
      "height": 1
    }
  ]
}
